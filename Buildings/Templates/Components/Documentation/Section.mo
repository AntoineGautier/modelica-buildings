within Buildings.Templates.Components.Documentation;
block Section "Block used to organize the documentation of control sequences"
  annotation (
  __cdl(Documentation(include=true, info="")), Icon(graphics={
        Text(
          extent={{-150,150},{150,110}},
          textColor={0,0,255},
          textString="%name"), Rectangle(extent={{-100,100},{100,-100}},
            lineColor={0,0,0})}));
end Section;
