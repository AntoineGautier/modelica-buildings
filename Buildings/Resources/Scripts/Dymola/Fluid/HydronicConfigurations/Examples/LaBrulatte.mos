simulateModel(
  "Buildings.Fluid.HydronicConfigurations.Examples.LaBrulatte",
  method="CVode",
  stopTime=86400,
  tolerance=1e-06,
  resultFile="LaBrulatte");

createPlot(
  id=1,
  position={5, 5, 400, 600},
  y={"TSup.T", "TRet.T", "TBoiRet.T", "TSup_nominal", "TRet_nominal"},
  timeUnit="h",
  erase=true,
  autoscale=true,
  grid=true,
  color=true
);
createPlot(
  id=1,
  subPlot=2,
  y={"boi.m_flow", "mPriSup.m_flow", "tanBoi.m_flow", "mBoi_flow_nominal", "mPri_flow_nominal"},
  timeUnit="h",
  erase=true,
  autoscale=true,
  grid=true,
  color=true
);
createPlot(
  id=1,
  subPlot=3,
  y={"con.yVal_actual"},
  timeUnit="h",
  erase=true,
  autoscale=true,
  grid=true,
  color=true
);
plotExpression(apply(LaBrulatte[end].QPri_flow.dH_flow/LaBrulatte[end].QBoi_flow_nominal), false, "yLoaPri", 1);
plotExpression(apply(LaBrulatte[end].boi.Q_flow/LaBrulatte[end].QBoi_flow_nominal), false, "yLoaBoi", 1);
